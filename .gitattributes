# Normalised line endings (LF) for every text file.
* text=auto eol=lf

# Development files excluded from installed packages (only src/, README.md and LICENSE are shipped).
/.github export-ignore
/tests export-ignore
/examples export-ignore
/worker export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/CHANGELOG.md export-ignore

# Repository sheet read by the publishing tool: never published.
/depot.json export-ignore
